# ──────────────────────────────────────────────
# VeloCal — Docker Compose Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in production values:
#   cp .env.example .env
#
# All variables with defaults are optional.
# Variables marked REQUIRED have no safe default.

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=velocal
DB_NAME=velocal
DB_PASSWORD=velocal

# ── Backend ───────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 32
JWT_SECRET=not-secret
JWT_EXPIRATION=7d

# Admin seed credentials (created on first boot)
ADMIN_EMAIL=admin@invalid.email
ADMIN_PASSWORD=12notsecret34

# Minutes between allowed import triggers
IMPORT_COOLDOWN_MINUTES=5

# Race Result import: country codes (comma-separated)
# 276 = Germany, 528 = Netherlands
RACE_RESULT_COUNTRIES=276,528

# ── SEO / SSR ─────────────────────────────────
# Public origin used in canonical URLs, og:url, sitemap.xml
SITE_URL=https://velocal.cc

# Hosts the SSR server accepts (comma-separated)
NG_ALLOWED_HOSTS=velocal.cc,www.velocal.cc,localhost

# ── Resend ────────────────────────────────────
# REQUIRED
# ── Web Push ──────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Never change the public key afterwards: every device would lose its subscription.
# VAPID_SUBJECT must be a mailto: address (or https URL) you can be reached at.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: more push service hosts that may receive messages (comma separated, leading dot = subdomains)
# PUSH_ENDPOINT_HOSTS=

RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@system.velocal.cc
RESEND_FROM_NAME=VeloCal
